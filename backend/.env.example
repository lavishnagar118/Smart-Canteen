PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/smart-canteen
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=1d
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_admin_client_email
FIREBASE_PRIVATE_KEY=your_firebase_admin_private_key
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
KITCHEN_STAFF_COUNT=2
ANALYTICS_TIMEZONE=Asia/Kolkata

# AI Engine (Local Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=60000

# Production AI Engine (Render / Hosted deployment only)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.5-flash-lite

